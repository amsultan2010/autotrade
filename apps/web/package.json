    "@supabase/supabase-js": "^2.108.2",
    "gsap": "^3.15.0",
    "lightweight-charts": "^4.2.3",
    "next": "^15.1.0",
    "posthog-js": "^1.386.6",
    "posthog-node": "^5.38.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
