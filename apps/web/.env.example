# Autotrade — copy to apps/web/.env.local (never commit secrets)

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Clerk
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
CLERK_WEBHOOK_SECRET=whsec_...

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Internal
BOT_INTERNAL_SECRET=change-me-openssl-rand-hex-32
CRON_SECRET=change-me-cron-secret
# Generate: openssl rand -hex 32
BROKER_ENCRYPTION_KEY=

# Market / broker
MARKET_DATA_PROVIDER=alpaca
ALPACA_API_KEY=
ALPACA_API_SECRET=
ALPACA_PAPER=true

# Billing (optional)
BILLING_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_PRICE_ESSENTIAL=
STRIPE_PRICE_PRO=
STRIPE_PRICE_UNLIMITED=

# Email
RESEND_API_KEY=
RESEND_AUDIENCE_ID=
EMAIL_FROM=Autotrade <notifications@tryautotrade.com>

# Observability
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
SENTRY_DSN=
