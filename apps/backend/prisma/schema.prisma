// Autotrade — canonical database schema.
// See docs/ARCHITECTURE.md §4 for the design narrative.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────── Identity & access ───────────────────────────

enum Role {
  USER
  ADMIN
  DEVELOPER
}

enum UserStatus {
  ACTIVE
  DISABLED
}

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  passwordHash String
  role         Role       @default(USER)
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  subscription  Subscription?
  refreshTokens RefreshToken[]
  watchlist     WatchedSymbol[]
  botSettings   BotSettings?
  paperAccount  PaperAccount?
  trades        Trade[]
  signals       Signal[]
  strategyStats StrategyStat[]
  auditLogs     AuditLog[]      @relation("ActorAudit")

  @@index([role])
  @@index([status])
}

// Rotating refresh tokens. Only the hash is stored. `family` enables
// reuse-detection: if a revoked token is presented, revoke the whole family.
model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  family    String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([family])
}

// ─────────────────────────── Subscription ───────────────────────────

enum SubscriptionStatus {
  NONE
  ACTIVE
  PAST_DUE
  CANCELED
  TRIALING
}

model Subscription {
  id                   String             @id @default(cuid())
  userId               String             @unique
  user                 User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  stripeCustomerId     String?            @unique
  stripeSubscriptionId String?            @unique
  tier                 String? // e.g. "pro"
  status               SubscriptionStatus @default(NONE)
  currentPeriodEnd     DateTime?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  @@index([status])
}

// ─────────────────────────── Watchlist (unbounded) ───────────────────────────

model WatchedSymbol {
  id       String   @id @default(cuid())
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  symbol   String
  exchange String
  mic      String?
  addedAt  DateTime @default(now())

  @@unique([userId, symbol, exchange])
  @@index([userId])
}

// ─────────────────────────── Bot & risk settings ───────────────────────────

enum ExecutionMode {
  DISABLED
  PAPER
  LIVE
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
}

model BotSettings {
  id                   String        @id @default(cuid())
  userId               String        @unique
  user                 User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  mode                 ExecutionMode @default(PAPER)
  riskLevel            RiskLevel     @default(MEDIUM)
  maxActiveTrades      Int           @default(5)
  maxTradeSize         Float         @default(10000)
  riskPerTradePct      Float         @default(1.0)
  defaultStopPct       Float         @default(2.0)
  defaultTakeProfitPct Float         @default(4.0)
  maxDailyLoss         Float         @default(2000)
  tradingHoursStart    String        @default("09:30")
  tradingHoursEnd      String        @default("16:00")
  minConfidence        Int           @default(60)
  timeframes           String[]      @default(["5m", "15m", "1h", "1d"])
  strategies           String[]      @default(["TrendBreakout", "PullbackContinuation", "MeanReversion", "CryptoMomentum"])
  updatedAt            DateTime      @updatedAt
}

// ─────────────────────────── Decisions & trades ───────────────────────────

enum TradeAction {
  BUY
  SELL
  HOLD
  AVOID
  CLOSE
}

enum TradeSide {
  LONG
  SHORT
}

enum TradeResult {
  OPEN
  WIN
  LOSS
  BREAKEVEN
}

// Every decision the bot makes is recorded, even HOLD/AVOID, for auditability.
model Signal {
  id          String      @id @default(cuid())
  userId      String
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  ticker      String
  exchange    String
  price       Float
  timeframe   String
  strategy    String
  action      TradeAction
  confidence  Float
  riskLevel   RiskLevel
  entryReason String
  stopLoss    Float?
  takeProfit  Float?
  rrRatio     Float?
  explanation String
  createdAt   DateTime    @default(now())
  trade       Trade?

  @@index([userId, createdAt])
  @@index([ticker])
}

model Trade {
  id               String        @id @default(cuid())
  userId           String
  user             User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  signalId         String?       @unique
  signal           Signal?       @relation(fields: [signalId], references: [id])
  symbol           String
  exchange         String
  side             TradeSide
  mode             ExecutionMode
  qty              Float
  entryPrice       Float
  exitPrice        Float?
  stopLoss         Float?
  takeProfit       Float?
  pnl              Float?
  result           TradeResult   @default(OPEN)
  strategy         String
  confidence       Float
  entryReason      String
  exitReason       String?
  mistakeTags      String[]      @default([])
  // JSON snapshots of indicators/chart conditions at entry and exit (req #11)
  entrySnapshot    Json?
  exitSnapshot     Json?
  reasoningCorrect Boolean?
  openedAt         DateTime      @default(now())
  closedAt         DateTime?

  @@index([userId, openedAt])
  @@index([userId, result])
  @@index([symbol])
}

// Paper account is clearly separate and labeled (req #6).
model PaperAccount {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  balance   Float    @default(100000)
  equity    Float    @default(100000)
  updatedAt DateTime @updatedAt
}

// ─────────────────────────── Personalized learning ───────────────────────────

// Per-user, per-strategy (optionally per-symbol) realized stats. Drives the
// confidence weight that personalizes each user's bot (req #10, #12).
model StrategyStat {
  id                 String   @id @default(cuid())
  userId             String
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  strategy           String
  symbol             String   @default("") // "" = aggregate across all symbols
  trades             Int      @default(0)
  wins               Int      @default(0)
  losses             Int      @default(0)
  totalPnl           Float    @default(0)
  expectancy         Float    @default(0)
  weightedConfidence Float    @default(1.0) // bounded multiplier, e.g. 0.5–1.5
  updatedAt          DateTime @updatedAt

  @@unique([userId, strategy, symbol])
  @@index([userId])
}

// ─────────────────────────── Admin / ops ───────────────────────────

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  actor     User?    @relation("ActorAudit", fields: [actorId], references: [id], onDelete: SetNull)
  action    String
  target    String?
  meta      Json?
  ip        String?
  createdAt DateTime @default(now())

  @@index([actorId, createdAt])
  @@index([action])
}

model AppVersion {
  id          String   @id @default(cuid())
  version     String   @unique
  channel     String   @default("stable") // stable | beta
  notes       String?
  downloadUrl String?
  mandatory   Boolean  @default(false)
  publishedAt DateTime @default(now())
}

// Admin-managed provider/API config (e.g. which market data provider is active).
// Secret VALUES still live in env; this stores selection + non-secret options.
model ProviderSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}
