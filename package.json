{
  "name": "autotrade",
  "version": "0.1.0",
  "private": true,
  "description": "Autotrade — personalized AI-powered trading bot (Windows desktop + backend)",
  "packageManager": "pnpm@11.5.2",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev:backend": "pnpm --filter @autotrade/backend dev",
    "dev:desktop": "pnpm --filter @autotrade/desktop dev",
    "build": "pnpm -r build",
    "build:shared": "pnpm --filter @autotrade/shared build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "db:generate": "pnpm --filter @autotrade/backend prisma:generate",
    "db:migrate": "pnpm --filter @autotrade/backend prisma:migrate"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  }
}
