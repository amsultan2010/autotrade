{
  "name": "autotrade",
  "version": "0.1.0",
  "private": true,
  "description": "Autotrade — personalized AI-powered trading bot",
  "packageManager": "pnpm@11.5.2",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm dev:web",
    "dev:web": "pnpm --filter @autotrade/web dev",
    "dev:engine": "pnpm --filter @autotrade/worker dev",
    "build": "pnpm --filter @autotrade/shared build && pnpm -r --filter !@autotrade/shared build",
    "build:web": "pnpm --filter @autotrade/web build",
    "build:vercel": "pnpm --filter @autotrade/shared build && pnpm --filter @autotrade/engine generate && pnpm --filter @autotrade/web build",
    "build:worker": "pnpm --filter @autotrade/worker build",
    "typecheck": "pnpm -r typecheck",
    "typecheck:web": "pnpm --filter @autotrade/web typecheck",
    "typecheck:engine": "pnpm --filter @autotrade/engine typecheck && pnpm --filter @autotrade/worker typecheck",
    "check:boundaries": "bash scripts/check-boundaries.sh",
    "db:generate": "pnpm --filter @autotrade/engine generate",
    "setup": "pnpm --filter @autotrade/shared build && pnpm db:generate"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  }
}
