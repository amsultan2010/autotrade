{
  "name": "autotrade",
  "version": "0.1.0",
  "private": true,
  "description": "Autotrade — personalized AI-powered trading bot",
  "packageManager": "pnpm@11.5.2",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --filter @autotrade/web dev",
    "dev:web": "pnpm --filter @autotrade/web dev",
    "dev:worker": "pnpm --filter @autotrade/worker dev",
    "build": "pnpm -r build",
    "build:web": "pnpm --filter @autotrade/web build",
    "build:worker": "pnpm --filter @autotrade/worker build",
    "typecheck": "pnpm -r typecheck",
    "db:generate": "pnpm --filter @autotrade/engine prisma:generate",
    "db:migrate": "pnpm --filter @autotrade/engine prisma:migrate"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  }
}
