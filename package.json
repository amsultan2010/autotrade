{
  "name": "autotrade-ai",
  "version": "1.0.0",
  "private": true,
  "description": "Autotrade — AI-powered trading bot with premium console UI",
  "packageManager": "pnpm@9.15.4",
  "engines": { "node": ">=22.13" },
  "scripts": {
    "dev": "turbo dev",
    "dev:web": "pnpm --filter @autotrade/web dev",
    "dev:worker": "pnpm --filter @autotrade/worker dev",
    "build": "turbo build",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "check:boundaries": "bash scripts/check-boundaries.sh",
    "env:validate": "bash scripts/validate-env.sh"
  },
  "devDependencies": {
    "turbo": "^2.5.4",
    "typescript": "^5.6.3"
  },
  "pnpm": {
    "overrides": {
      "postcss": ">=8.5.10"
    }
  }
}
