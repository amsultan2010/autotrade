# ──────────────────────────────────────────────────────────────────────────
# Autotrade web app environment. Copy to `.env.local` for local dev, and set
# the same values in the Vercel project settings for production.
# NEVER commit the real .env.local.
#
# IMPORTANT: there are TWO separate places env vars live:
#   1. Vercel / .env.local  → the Next.js app (everything below except the
#      "CONVEX DASHBOARD" section).
#   2. Convex dashboard      → the Convex backend (auth + cron + bot actions).
#      Set these with `npx convex env set NAME value` or in the Convex
#      dashboard. They are NOT read from this file in production.
# ──────────────────────────────────────────────────────────────────────────

# ── Convex ────────────────────────────────────────────────────────────────
# From `npx convex dev` / the Convex dashboard. Public URL is safe to expose.
NEXT_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud
# Optional: server-side override; falls back to NEXT_PUBLIC_CONVEX_URL.
CONVEX_URL=

# ── Clerk (auth) ──────────────────────────────────────────────────────────
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx
# Svix signing secret for the Clerk webhook → /api/v1/webhooks/clerk.
# Without this, new users are NEVER seeded into Convex (the app self-heals via
# ensureExists on sign-in, but the webhook is still the primary path).
CLERK_WEBHOOK_SECRET=whsec_xxx

# ── Internal bot bridge ───────────────────────────────────────────────────
# Shared secret that authenticates Convex → Next.js internal calls (the bot
# cycle, broker-credential sync, weekly digest). Generate: openssl rand -hex 32
# MUST be identical here and in the Convex dashboard.
BOT_INTERNAL_SECRET=change-me-internal-secret
# Public base URL of THIS deployment (no trailing slash). Convex calls back
# into it for the bot cycle. e.g. https://tryautotrade.com
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Market data + broker (Alpaca) ─────────────────────────────────────────
# Provider used for symbol search, quotes, and candles. DEFAULTS TO "stooq",
# so you MUST set this to "alpaca" or the Alpaca API is never called (this is
# why symbol search / the watchlist appears broken). Options:
#   alpaca | twelvedata | finnhub | stooq
MARKET_DATA_PROVIDER=alpaca
# Free Alpaca keys (no card) at https://alpaca.markets — one key pair covers
# market data + paper + live trading.
ALPACA_API_KEY=your_alpaca_key_id
ALPACA_API_SECRET=your_alpaca_secret
ALPACA_FEED=iex          # iex = free real-time; sip = full market (paid)
ALPACA_PAPER=true        # true = paper-trading endpoints
ALPACA_STREAMING=true
STREAM_PROVIDER=auto
# Only needed if MARKET_DATA_PROVIDER is one of these:
TWELVEDATA_API_KEY=
FINNHUB_API_KEY=

# AES-256-GCM key used to encrypt stored broker credentials. 64 hex chars.
# Generate: openssl rand -hex 32. MUST match the value in the Convex dashboard.
BROKER_ENCRYPTION_KEY=

# ── Engine (required for bot scan + market data routes) ───────────────────
CONVEX_URL=
# Same value as NEXT_PUBLIC_CONVEX_URL — used by the engine package at runtime.
# Generate strong random values: openssl rand -base64 48
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
PAPER_STARTING_BALANCE=100000

# ── Billing (Stripe disabled until ready) ─────────────────────────────────
BILLING_ENABLED=false
FOUNDER_LIVE_EMAIL=abdullahmsultan1@gmail.com

# Stripe — only required when BILLING_ENABLED=true
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
STRIPE_PRICE_ELITE=

# ── Email (Resend) ────────────────────────────────────────────────────────
# Create API key at https://resend.com/api-keys
# Verify tryautotrade.com domain in Resend before sending from production.
RESEND_API_KEY=re_xxx
# Audience for marketing contacts (welcome sync + digest opt-out). Create at Resend → Audiences.
RESEND_AUDIENCE_ID=
# Optional override — defaults to Autotrade <noreply@tryautotrade.com>
# RESEND_FROM_EMAIL=noreply@tryautotrade.com

# ── Analytics / monitoring (optional) ─────────────────────────────────────
# Project API key (phc_…), NOT a personal API key (phx_…)
# PostHog → Project Settings → Project API key
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
NEXT_PUBLIC_POSTHOG_UI_HOST=https://us.posthog.com
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=                 # optional server-only fallback if public DSN unset
SENTRY_ORG=amsultan2010
SENTRY_PROJECT=javascript-nextjs
SENTRY_AUTH_TOKEN=        # source-map upload at build + scripts/setup-sentry-alerts.sh
SENTRY_NOTIFY_EMAIL=        # alert recipient (defaults to org owner)
SENTRY_NOTIFY_USER_ID=      # optional Sentry member id override
SENTRY_DEBUG=false        # set true locally to log Sentry init issues

# ══════════════════════════════════════════════════════════════════════════
# CONVEX DASHBOARD — set these in Convex, NOT in Vercel/.env.local
# (`npx convex env set NAME value`)
# ══════════════════════════════════════════════════════════════════════════
# CLERK_JWT_ISSUER_DOMAIN   https://<your-subdomain>.clerk.accounts.dev
#                           (Production: your Clerk Frontend API URL.) If this
#                           is wrong, EVERY authenticated Convex query returns
#                           null — settings, watchlist, and the bot all break
#                           together. Also requires a Clerk JWT template named
#                           exactly "convex".
# BOT_INTERNAL_SECRET       same value as above
# NEXT_PUBLIC_APP_URL       deployed web URL (e.g. https://tryautotrade.com)
# BROKER_ENCRYPTION_KEY     same value as above
# BILLING_ENABLED           false until Stripe is ready
# FOUNDER_LIVE_EMAIL        abdullahmsultan1@gmail.com
