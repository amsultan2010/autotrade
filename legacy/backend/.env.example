# ─────────────────────────────────────────────────────────────────────────
# Quantara backend environment. Copy to `.env` and fill in.
# NEVER commit the real .env. All secrets live here, only on the server.
# ─────────────────────────────────────────────────────────────────────────

NODE_ENV=development
PORT=4000
# Comma-separated allowlist of desktop/web origins permitted to call the API.
CORS_ORIGINS=http://localhost:5173,app://alphabot

# PostgreSQL connection string
DATABASE_URL=postgresql://alphabot:alphabot@localhost:5432/alphabot?schema=public

# Auth — generate strong random values, e.g. `openssl rand -base64 48`
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_DAYS=30

# Stripe — backend is the source of truth for subscription state
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_PRICE_ID=price_xxx            # the single paid tier ("Quantara Pro")
CHECKOUT_SUCCESS_URL=app://alphabot/billing/success
CHECKOUT_CANCEL_URL=app://alphabot/billing/cancel

# Market data provider (swappable): alpaca | twelvedata | finnhub | stooq
#  - alpaca:     free REAL-TIME WebSocket streaming + broker — RECOMMENDED
#                get free Paper keys at https://alpaca.markets (no card)
#  - twelvedata: free REST multi-timeframe (8 req/min) — get key at twelvedata.com
#  - finnhub:    candles require a PAID plan
#  - stooq:      keyless but behind anti-bot protection (unreliable)
MARKET_DATA_PROVIDER=alpaca
ALPACA_API_KEY=your_alpaca_key_id
ALPACA_API_SECRET=your_alpaca_secret
ALPACA_FEED=iex          # iex = free real-time; sip = full market (paid)
ALPACA_PAPER=true        # true = paper trading endpoints
ALPACA_STREAMING=true    # true = real-time stream engine; false = 60s polling

TWELVEDATA_API_KEY=
FINNHUB_API_KEY=

# Optional: starting paper-trading balance for new users
PAPER_STARTING_BALANCE=100000
